{
    "robot_control":
    {
        "pragma:default": null,

        "lance2":
        {
            "controller": 2,

            "default_stick_deadzone": 0.05,
            "driving_magnitude_deadzone": 0.1,
            "driving_low_scalar": 0.3,
            "driving_medium_scalar": 0.7,
            "driving_high_scalar": 1.0,

            "trencher":
            {
                "max_velocity_rps": 160.0,
                "mining_velocity_rps": 160.0
            },

            "hopper_belt":
            {
                "max_velocity_rps": 135.0,
                "mining_velocity_rps": 10.0,
                "mining_duty_cycle_base_seconds": 1.0
            },

            "tracks":
            {
                "max_velocity_rps": 125.0,
                "mining_velocity_rps": 8.0,
                "mining_adjustment_range_rps": 6.0,
                "offload_velocity_rps": 30.0
            },

            "hopper_actuator":
            {
                "max_speed": 1.0,
                "plunge_speed": 0.4,
                "extract_speed": 0.8,
                "offload_target_val": 0.95,
                "traversal_target_val": 0.6,
                "transport_target_val": 0.55,
                "mining_target_val": 0.21,
                "mining_min_val": 0.03,
                "targetting_thresh": 0.01
            },

            "collection_model":
            {
                "initial_volume_liters": 40.0,
                "capacity_volume_liters": 40.0,
                "initial_belt_footprint_meters": 0.5,
                "belt_capacity_meters": 0.75,
                "belt_offload_length_meters": 1.2,
                "transfer_efficiency": 0.5
            },

            "iteration_period_seconds": 0.05,
            "odom_frame_id": "${ id.odom_frame }",
            "arena_frame_id": "${ id.arena_frame }",

            "auto_localization":
            {
                "min_num_search_samples": 100,
                "search_angular_velocity_rps": 0.5,
                "align_angular_velocity_rps": 0.25,
                "align_angular_thresh_deg": 2.0,
                "range_target_m": 1.05,
                "range_thresh_m": 0.05
            },

            "auto_traversal":
            {
                "max_track_velocity_mps": 0.35,
                "max_track_acceleration_mpss": 1.0,
                "max_angular_velocity_rps": 0.8,
                "max_angular_accel_rpss": 0.5,
                "destination_thresh_m": 0.03,
                "max_path_deviation_m": 0.02,
                "stanley_k_coeff": 0.8,
                "angular_kp": 1.5,
                "min_theta_window_deg": 2.0,
                "align_angular_thresh_deg": 0.5
            },

            "auto_mining":
            {
                "min_path_length" : 1.1,
                "min_replan_vol_liters" : 8.0,
                "max_iterations" : 3
            },

            "mining_zone_bounds": "${ zone.ksc.mining }",
            "offload_zone_bounds": "${ zone.ksc.offload }",
            "construction_zone_bounds": "${ zone.ksc.construction }"
        },
        "lance1":
        {
            "pragma:derived": "lance2",
            "controller": 1,

            "trencher":
            {
                "max_velocity_rps": 80.0,
                "mining_velocity_rps": 80.0
            },
            "collection_model":
            {
                "initial_volume_liters": 10.0,
                "capacity_volume_liters": 25.0,
                "initial_belt_footprint_meters": 0.3,
                "belt_capacity_meters": 0.6,
                "belt_offload_length_meters": 0.7
            },
            "auto_traversal":
            {
                "max_track_velocity_mps": 0.35,
                "max_track_acceleration_mpss": 1.0,
                "max_angular_velocity_rps": 0.7,
                "max_angular_accel_rpss": 0.5,
                "destination_thresh_m": 0.03,
                "max_path_deviation_m": 0.05,
                "stanley_k_coeff": 0.5,
                "angular_kp": 1.5,
                "min_theta_window_deg": 2.0,
                "align_angular_thresh_deg": 0.5
            }
        },

        "lance2_sim":
        {
            "pragma:derived": "lance2",
            "use_sim_time": true
        },
        "lance1_sim":
        {
            "pragma:derived": "lance1",
            "use_sim_time": true
        },



        "lance2_ksc":
        {
            "pragma:derived": "lance2"
        },
        "lance2_ucf_right":
        {
            "pragma:derived": "lance2",
            "mining_zone_bounds": "${ zone.ucf_right.mining }",
            "offload_zone_bounds": "${ zone.ucf_right.offload }",
            "construction_zone_bounds": "${ zone.ucf_right.construction }"
        },
        "lance2_ucf_left":
        {
            "pragma:derived": "lance2",
            "mining_zone_bounds": "${ zone.ucf_left.mining }",
            "offload_zone_bounds": "${ zone.ucf_left.offload }",
            "construction_zone_bounds": "${ zone.ucf_left.construction }"
        },

        "lance2_ksc_sim":
        {
            "pragma:derived": "lance2_sim"
        },
        "lance2_ucf_right_sim":
        {
            "pragma:derived": "lance2_ucf_right",
            "use_sim_time": true
        },
        "lance2_ucf_left_sim":
        {
            "pragma:derived": "lance2_ucf_left",
            "use_sim_time": true
        },



        "lance1_ksc":
        {
            "pragma:derived": "lance1"
        },
        "lance1_ucf_right":
        {
            "pragma:derived": "lance1",
            "mining_zone_bounds": "${ zone.ucf_right.mining }",
            "offload_zone_bounds": "${ zone.ucf_right.offload }",
            "construction_zone_bounds": "${ zone.ucf_right.construction }"
        },
        "lance1_ucf_left":
        {
            "pragma:derived": "lance1",
            "mining_zone_bounds": "${ zone.ucf_left.mining }",
            "offload_zone_bounds": "${ zone.ucf_left.offload }",
            "construction_zone_bounds": "${ zone.ucf_left.construction }"
        },

        "lance1_ksc_sim":
        {
            "pragma:derived": "lance1_sim"
        },
        "lance1_ucf_right_sim":
        {
            "pragma:derived": "lance1_ucf_right",
            "use_sim_time": true
        },
        "lance1_ucf_left_sim":
        {
            "pragma:derived": "lance1_ucf_left",
            "use_sim_time": true
        }
    }
}
