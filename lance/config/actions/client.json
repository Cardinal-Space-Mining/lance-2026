{
    "pplan_client":
    {
        "pragma:default": null,
        "enabled": {}
    },

    "robot_status":
    {
        "pragma:default": null,
        "enabled": {}
    },

    "joy_node":
    {
        "pragma:default": null,
        "enabled": {}
    },

    "mission_control":
    {
        "pragma:default": null,

        "lance1_ksc":
        {
            "controller": 1,

            "odom_frame_id": "${ id.odom_frame }",
            "arena_frame_id": "${ id.arena_frame }",
            "robot_frame_id": "${ id.robot_frame }",
            "arena_bounds": "${ zone.ksc.arena }",
            "mining_zone_bounds": "${ zone.ksc.mining }",
            "offload_zone_bounds": "${ zone.ksc.offload }"
        },
        "lance1_ucf_right":
        {
            "pragma:derived": "lance1_ksc",

            "arena_bounds": "${ zone.ucf_right.arena }",
            "mining_zone_bounds": "${ zone.ucf_right.mining }",
            "offload_zone_bounds": "${ zone.ucf_right.offload }"
        },
        "lance1_ucf_left":
        {
            "pragma:derived": "lance1_ksc",

            "arena_bounds": "${ zone.ucf_left.arena }",
            "mining_zone_bounds": "${ zone.ucf_left.mining }",
            "offload_zone_bounds": "${ zone.ucf_left.offload }"
        },

        "lance2_ksc":
        {
            "pragma:derived": "lance1_ksc",
            "controller": 2
        },
        "lance2_ucf_right":
        {
            "pragma:derived": "lance1_ucf_right",
            "controller": 2
        },
        "lance2_ucf_left":
        {
            "pragma:derived": "lance1_ucf_left",
            "controller": 2
        },


        "lance1_ksc_sim":
        {
            "pragma:derived": "lance1_ksc",
            "use_sim_time": true
        },
        "lance1_ucf_right_sim":
        {
            "pragma:derived": "lance1_ucf_right",
            "use_sim_time": true
        },
        "lance1_ucf_left_sim":
        {
            "pragma:derived": "lance1_ucf_left",
            "use_sim_time": true
        },

        "lance2_ksc_sim":
        {
            "pragma:derived": "lance2_ksc",
            "use_sim_time": true
        },
        "lance2_ucf_right_sim":
        {
            "pragma:derived": "lance2_ucf_right",
            "use_sim_time": true
        },
        "lance2_ucf_left_sim":
        {
            "pragma:derived": "lance2_ucf_left",
            "use_sim_time": true
        }
    }
}
