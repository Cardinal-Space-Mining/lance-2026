{
    "pragma:enable_preproc": true,
    "pragma:import":
    [
        "actions/bag.json",
        "actions/client.json",
        "actions/foxglove.json",
        "actions/multiscan_driver.json",
        "actions/perception.json",
        "actions/phoenix_driver.json",
        "actions/redux.json",
        "actions/robot_control.json",
        "actions/shared.json",
        "actions/sim.json",
        "actions/tf.json"
    ],

    "preset":
    {
        "pragma:default": null,

        "robot_l1":
        {
            "pragma:action_overrides":
            {
                "robot_tf": "lance",
                "multiscan_driver": "net1",
                "robot_control": "lance1",
                "perception": "lance1",
                "redux": "robot",
                "phoenix5_driver": "enabled",
                "phoenix6_driver": "enabled",
                "bag_record": "telemetry"
            }
        },
        "client_l1":
        {
            "pragma:action_overrides":
            {
                "robot_tf": "lance",
                "robot_control": "lance1",
                "perception": "lance1",
                "redux": "client_panda",
                "bag_record": "all",
                "robot_status": "enabled",
                "joy_node": "enabled",
                "foxglove_bridge": "all",
                "zone_viz": "ksc"
            }
        },

        "robot_dev":
        {
            "pragma:action_overrides":
            {
                "robot_tf": "lance2",
                "multiscan_driver": "net2",
                "robot_control": "lance2",
                "motor_sim": "lance2",
                "perception": "lidar_only",
                "redux": "robot",
                "foxglove_bridge": "all"
            }
        },
        "client_dev":
        {
            "pragma:action_overrides":
            {
                "joy_node": "enabled",
                "robot_status": "enabled",
                "redux": "client_mac_wifi",
                "robot_control": "lance2",
                "perception": "lidar_only",
                "foxglove_bridge": "all"
            }
        },

        "motor_dev":
        {
            "pragma:action_overrides":
            {
                "joy_node": "enabled",
                "robot_status": "enabled",
                "robot_control": "lance2",
                "motor_sim": "lance2",
                "robot_tf": "lance2",
                "foxglove_bridge": "all"
            }
        },
        "gz_dev":
        {
            "pragma:action_overrides":
            {
                "joy_node": "enabled",
                "robot_status": "enabled",
                "robot_control": "lance2_sim",
                "motor_sim": "gz_sim_l2",
                "perception": "lance2_sim",
                "pplan_client": "enabled",
                "gz_sim": "motor_sim_l2",
                "robot_tf": "lance2",
                "foxglove_bridge": "all",
                "zone_viz": "ksc"
            }
        },
        "gz_dev_l1":
        {
            "pragma:derived": "gz_dev",
            "pragma:action_overrides":
            {
                "robot_control": "lance1",
                "motor_sim": "gz_sim_l1",
                "perception": "lance1_sim",
                "gz_sim": "motor_sim_l1",
                "robot_tf": "lance"
            }
        },
        "lidar_dev":
        {
            "pragma:action_overrides":
            {
                "multiscan_driver": "net1",
                "perception": "lidar_only",
                "pplan_client": "enabled",
                "foxglove_bride": "all",
                "foxglove_gui": "local"
            }
        },
        "lidar_bag":
        {
            "pragma:action_overrides":
            {
                "perception": "lance1",
                "pplan_client": "enabled",
                "robot_tf": "lance1",
                "foxglove_bridge": "all",
                "foxglove_gui": "local"
            }
        },
        "lidar_bag_l2":
        {
            "pragma:derived": "lidar_bag",
            "pragma:action_overrides":
            {
                "perception": "lance2",
                "robot_tf": "lance2"
            }
        }
    }
}
